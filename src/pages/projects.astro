---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { byDateDesc } from '../lib/content'

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(byDateDesc)
---

<BaseLayout
  title="Projects"
  description="Infrastructure tools and learning projects. Kubernetes operators, eBPF tracers, and distributed systems experiments."
>
  <div class="content-col">
    <div class="rule-label"><span>projects</span></div>

    <ul class="list-none">
      {projects.map((project) => (
        <li class="proj-item">
          <div class="flex justify-between items-baseline mb-1.5">
            <a href={`/projects/${project.id}`} class="proj-name">
              {project.data.title}
            </a>
            {project.data.repo && (
              <a href={project.data.repo} class="proj-ext">
                ↗ github
              </a>
            )}
          </div>
          <p class="proj-desc">{project.data.description}</p>
          <div class="flex gap-1.5 flex-wrap">
            {project.data.tags.map((tag) => <span class="chip">{tag}</span>)}
          </div>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
