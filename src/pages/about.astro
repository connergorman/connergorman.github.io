---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

const [profile] = await getCollection('about')

if (!profile) {
  throw new Error('Missing about profile at src/content/about/profile.mdx')
}

const { Content } = await render(profile)
---

<BaseLayout title={profile.data.title} description={profile.data.description}>
  <div class="content-col">
    <div class="max-w-prose mb-10">
      <p class="font-serif text-lede italic text-ink-2 leading-[1.7] mb-6">
        {profile.data.lede}
      </p>
      <div class="prose-content about-copy">
        <Content />
      </div>
    </div>

    <div class="mb-10">
      <div class="rule-label"><span>links</span></div>
      <div class="flex flex-col gap-2.5 mt-4">
        {profile.data.links.map((link) => (
          <a href={link.href} class="social-link">
            <span>{link.label}</span>
            {link.external && <span>↗</span>}
          </a>
        ))}
      </div>
    </div>

    <div class="mb-10">
      <div class="rule-label"><span>experience</span></div>
      <ul class="list-none">
        {profile.data.experience.map((item) => (
          <li class="exp-item">
            <div class="flex justify-between items-baseline mb-1">
              <span class="exp-org">
                {item.title}{item.organization && ` · ${item.organization}`}
              </span>
              <span class="exp-date">{item.date}</span>
            </div>
            <p class="exp-role">{item.summary}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="mb-10">
      <div class="rule-label"><span>education</span></div>
      <ul class="list-none">
        {profile.data.education.map((item) => (
          <li class="exp-item">
            <div class="flex justify-between items-baseline mb-1">
              <span class="exp-org">
                {item.title}{item.organization && ` · ${item.organization}`}
              </span>
              <span class="exp-date">{item.date}</span>
            </div>
            <p class="exp-role">{item.summary}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="mb-10">
      <div class="rule-label"><span>stack</span></div>
      <div class="flex flex-wrap gap-2 mt-4">
        {profile.data.skills.map((skill) => <span class="skill-tag">{skill}</span>)}
      </div>
    </div>
  </div>
</BaseLayout>
