---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import { byDateDesc, formatMonthYear, groupWritingByYear, pillClass } from '../lib/content'

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(byDateDesc)
const postsByYear = groupWritingByYear(posts)
const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a))
---

<BaseLayout
  title="Writing"
  description="Technical posts on Kubernetes, distributed systems, and eBPF. Occasional notes on philosophy."
>
  <div class="content-col">
    {years.map((year) => (
      <div class="mb-8">
        <div class="year-label">{year}</div>
        <ul class="post-list">
          {postsByYear[year].map((post) => (
            <li class="post-item">
              <a href={`/writing/${post.id}`} class="post-title">
                {post.data.title}
              </a>
              <div class="post-meta">
                <span class={`pill ${pillClass(post.data.category)}`}>
                  {post.data.category}
                </span>
                <span class="post-date">{formatMonthYear(post.data.date)}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</BaseLayout>
