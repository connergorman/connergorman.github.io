---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { byDateDesc, formatMonthYear, pillClass } from '../lib/content'

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(byDateDesc)
const recentPosts = posts.slice(0, 3)
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(byDateDesc)
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 2)
---

<BaseLayout
  title="Home"
  description="Software engineer and former professional philosopher."
>
  <div class="content-col">
    <!-- Hero -->
    <div class="mb-11">
      <div class="hero-eyebrow">
        <span>CURRENTLY</span>
      </div>
      <h1 class="hero-name">
        Software engineer.
        <em>Philosopher in the margins.</em>
      </h1>
      <div class="hero-body mb-6">
        <p class="mb-3">
          I build systems that help engineers ship faster, more easily, and more reliably.
          I also sometimes write about philsophy, especially philosophy of science and 
          political philosophy. 
        </p>
        <p>
          This site is where I write about both. Sometimes they intersect.
        </p>
      </div>
      <div class="flex gap-2 flex-wrap">
        <span class="hchip hchip-hi">kubernetes</span>
        <span class="hchip">go</span>
        <span class="hchip">ebpf</span>
        <span class="hchip">philosophy</span>
      </div>
    </div>

    <!-- Recent writing -->
    <div class="mt-10">
      <div class="rule-label"><span>recent writing</span></div>
      <ul class="post-list">
        {recentPosts.map((post) => (
          <li class="post-item">
            <a href={`/writing/${post.id}`} class="post-title">
              {post.data.title}
            </a>
            <div class="post-meta">
              <span class={`pill ${pillClass(post.data.category)}`}>
                {post.data.category}
              </span>
              <span class="post-date">{formatMonthYear(post.data.date)}</span>
            </div>
          </li>
        ))}
      </ul>
      <a href="/writing" class="see-all">
        see all writing →
      </a>
    </div>

    <!-- Featured projects -->
    <div class="mt-10">
      <div class="rule-label"><span>featured projects</span></div>
      <ul class="list-none">
        {featuredProjects.map((project) => (
          <li class="proj-item">
            <div class="flex justify-between items-baseline mb-1.5">
              <a href={`/projects/${project.id}`} class="proj-name">
                {project.data.title}
              </a>
              {project.data.repo && (
                <a href={project.data.repo} class="proj-ext">
                  ↗ github
                </a>
              )}
            </div>
            <p class="proj-desc">{project.data.description}</p>
            <div class="flex gap-1.5 flex-wrap">
              {project.data.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </li>
        ))}
      </ul>
      <a href="/projects" class="see-all">
        see all projects →
      </a>
    </div>
  </div>
</BaseLayout>
